# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site, used for canonical and hreflang links.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local testing only (ignored outside `npm run dev`): pretend the visitor is in
# this country, like Vercel's x-vercel-ip-country header. RU opens Russian at "/".
# Leave empty to get the default (English). A language picked in the toggle still wins.
DEV_COUNTRY=

# Sanity project with the services and site settings (required). Not secret: the dataset is public.
# Also set both in Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Contact form email (SMTP). Gmail: an App password, not the account password
# (Google Account → Security → 2-Step Verification → App passwords).
# Without these the form still "succeeds" but only logs the request (fine for local work).
# In Vercel add them as "Secret" (at least SMTP_PASS). Server-only: never prefix with NEXT_PUBLIC_.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Inbox that receives the form submissions (can be the same as SMTP_USER).
MAIL_TO=
