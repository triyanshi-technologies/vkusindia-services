# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site, used for canonical and hreflang links.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local testing only (ignored outside `npm run dev`): pretend the visitor is in
# this country, like Vercel's x-vercel-ip-country header. RU opens Russian at "/".
# Leave empty to get the default (English). A language picked in the toggle still wins.
DEV_COUNTRY=
